# Copy to .env.local (local) or add in Vercel → Project → Settings → Environment Variables.

# Required. Panta API key (pk_live_... or pk_test_...). Get one: node scripts/get-panta-key.mjs
PANTA_API_KEY=

# Required for on-chain actions. Use a dedicated mainnet RPC (Helius, Triton, QuickNode).
# Server-only: the browser reaches it through /api/rpc, so the provider key stays private.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional custom domain for share cards. On Vercel the default domain is detected automatically.
SITE_URL=

# Optional: enables AI briefs. Model defaults to gpt-5-mini.
OPENAI_API_KEY=
OPENAI_MODEL=

# Protects /api/cron/warm. Any long random string.
CRON_SECRET=
