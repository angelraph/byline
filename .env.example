# Copy to .env.local (local) or add in Vercel → Project → Settings → Environment Variables.

# Required. Panta API key (pk_live_... or pk_test_...). Get one: node scripts/get-panta-key.mjs
PANTA_API_KEY=

# Required for on-chain actions. A dedicated mainnet RPC (Helius, Triton, QuickNode) is strongly
# recommended; the public endpoint rate-limits and rejects many transaction sends.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Public site URL, used for share cards (e.g. https://byline.vercel.app).
NEXT_PUBLIC_SITE_URL=

# Optional: enables AI briefs. Model defaults to gpt-5-mini.
OPENAI_API_KEY=
OPENAI_MODEL=

# Protects /api/cron/warm. Any long random string.
CRON_SECRET=
